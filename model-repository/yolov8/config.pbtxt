# Triton configuration for a YOLOv8 detector exported to ONNX.
#
# Export (see ../../models/export_yolov8.py):
#   yolo export model=yolov8n.pt format=onnx imgsz=640 opset=12 dynamic=True
# then place the result at:  yolov8/1/model.onnx
#
# NOTE: the tensor names/shapes below match a standard Ultralytics YOLOv8 ONNX
# export. If your export differs (image size, opset, class count) confirm them
# with `polygraphy inspect model yolov8/1/model.onnx` and update accordingly.

name: "yolov8"
backend: "onnxruntime"
max_batch_size: 8

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [ 3, 640, 640 ] # CHW, RGB, pixels scaled to 0..1 (client-side)
  }
]

# YOLOv8 head: 84 = 4 box coords + 80 COCO classes; 8400 anchor points at 640px.
# These are RAW predictions — the client must run NMS to get final boxes.
output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [ 84, 8400 ]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]

# Coalesce bursts of single-image requests into GPU batches transparently.
dynamic_batching {
  preferred_batch_size: [ 4, 8 ]
  max_queue_delay_microseconds: 100
}

version_policy: { latest: { num_versions: 1 } }
