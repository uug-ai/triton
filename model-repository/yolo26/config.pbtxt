# Triton configuration for a YOLO26 detector exported to ONNX.
#
# Export (see ../../models/export_yolo26.py):
#   yolo export model=yolo26n.pt format=onnx imgsz=640 opset=12 dynamic=True
# then place the result at:  yolo26/1/model.onnx
#
# YOLO26 is END-TO-END / NMS-FREE: the model emits final detections directly, so
# NO client-side NMS is required (unlike yolov8). The output below assumes the
# standard end-to-end export of up to 300 detections as
# [x1, y1, x2, y2, score, class]. Confirm the names/shapes for your export with
# `polygraphy inspect model yolo26/1/model.onnx` and adjust if needed.

name: "yolo26"
backend: "onnxruntime"
max_batch_size: 8

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [ 3, 640, 640 ] # CHW, RGB, pixels scaled to 0..1 (client-side)
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [ 300, 6 ] # up to 300 dets: x1, y1, x2, y2, score, class
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]

dynamic_batching {
  preferred_batch_size: [ 4, 8 ]
  max_queue_delay_microseconds: 100
}

version_policy: { latest: { num_versions: 1 } }
